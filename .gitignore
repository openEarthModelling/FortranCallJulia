# CMake build directory
build/
cmake-build-*/

# Compiled Object files
*.o
*.mod
*.smod

# Executables
test_app
*.exe
*.out

# Julia
*.ji

# Editors
.vscode/
.idea/
*.swp
*~

# Documentation references
docs/references/

# Example build artifacts (any nesting depth; 2_compiled_library/dist alone
# holds ~292 MB of Julia runtime libraries once built)
examples/**/dist/
examples/**/build/
examples/**/demo_app

# Sysimage scratch env (generated by scripts/install_sciml_env.jl)
scripts/sysimage_env/
# FjKinetics package Manifest: regenerated by install_sciml_env.jl (the
# ChemMechSim dev-path entry points outside the repo, so a tracked copy
# breaks instantiate on any other machine)
examples/07_capstone/FjKinetics/Manifest.toml
examples/07_capstone/3_aot_kinetics/dist/
examples/07_capstone/3_aot_kinetics/build/
examples/07_capstone/3_aot_kinetics/aot_bench
# figure data (regenerable: run the driver)
examples/07_capstone/output/

# graphify knowledge-graph outputs (local only, never commit)
graphify-out/

# MkDocs docs toolchain and rendered site output
.venv-docs/
site/

# pytest local cache and bytecode (docs parity gate unit tests)
.pytest_cache/
__pycache__/
